{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build mem0sharp-agent",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/mem0sharp-agent/mem0sharp-agent.csproj",
                "--no-restore"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
